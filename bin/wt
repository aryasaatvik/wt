#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# wt - git worktree helper
#
# Quickly spin up git worktrees with all the gitignored config
# files (env, scratchpad, editor settings, etc.) synced from
# the source repo, then install dependencies automatically.
#
# Usage:
#   wt [new|create] <branch> [base] [flags]  Create worktree (or checkout existing branch)
#   wt rm|remove <branch> [flags]            Remove worktree (keeps branch by default)
#                                            Pass -D/--delete-branch to also delete the branch
#   wt ls|list [flags]                       List all worktrees
#   wt -h | --help                   Show this help
#   wt --no-install                  Skip dependency install
#   wt --verbose                     Verbose rsync output
#
# Worktree layout:
#   Worktrees are created as siblings of the repo directory:
#     ~/Developer/myrepo/             <- source repo
#     ~/Developer/myrepo-worktrees/   <- worktree parent
#       x-my-feature/                 <- branch x/my-feature (slashes → dashes)
#       fix-login-bug/                <- branch fix-login-bug
#
# File sync:
#   Uses `git ls-files --others --ignored --exclude-standard` to
#   find all gitignored files in the source repo, then filters
#   through `git check-ignore` in the worktree so only files that
#   are also ignored by the base branch's gitignore are synced.
#   This prevents untracked files when the source checkout has a
#   different .gitignore than the base branch.
#   Heavy artifacts (node_modules, build dirs, etc.) are excluded
#   via the SYNC_EXCLUDE array below. Edit that array to customize.
#
# Dependencies:
#   Install step uses `ni` (https://github.com/antfu/ni) which
#   auto-detects the package manager from the lockfile. Skipped
#   gracefully if ni is not installed or no lockfile is present.
#
# Design notes:
#   - .git in a worktree is a file (not a dir) pointing back to
#     the main repo. Tools like `hk install` that assume .git is
#     a directory will fail. The prepare script in package.json
#     guards with `[ -f .git ]` to skip hook install in worktrees.
#   - rsync copies filesystem state, not git state. This is
#     intentional — .env files and .scratchpad are gitignored so
#     they have no committed version to extract from git.
#   - The spinner hides cursor and clears its line on exit.
#     The ni install step does NOT use the spinner so its output
#     (package list, timing) is visible to the user.
#   - Paths are resolved via `cd .. && pwd` to avoid displaying
#     ugly /foo/../bar-worktrees paths.
#
# Completions: ~/.zsh/completions/wt.zsh
# ──────────────────────────────────────────────────────────────

set -euo pipefail

# ANSI colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# Braille spinner frames
SPINNER=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)

# Exclusions for gitignored file sync (heavy/generated artifacts)
SYNC_EXCLUDE=(
  # JS/TS
  node_modules .next .turbo dist .vercel .cache
  # Infra
  .sst
  # Xcode/Swift
  build .build DerivedData Pods Carthage xcuserdata
  # Misc
  .wrangler
)

log()  { printf "  ${GREEN}✓${NC} %b\n" "$1"; }
info() { printf "  ${CYAN}→${NC} %b\n" "$1"; }
err()  { printf "  ${RED}✗${NC} %b\n" "$1" >&2; }

TEMP_FILES=()

cleanup() {
  if [[ ${#TEMP_FILES[@]} -gt 0 ]]; then
    rm -f "${TEMP_FILES[@]}"
  fi
}
trap cleanup EXIT

make_temp_file() {
  local path
  path="$(mktemp -t "$1.XXXXXX")"
  TEMP_FILES+=("$path")
  printf "%s\n" "$path"
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    err "Required command not found: ${BOLD}$1${NC}"
    exit 1
  fi
}

has_dependency_config() {
  local dir="$1"
  [[ -f "$dir/bun.lock" ]] && return 0
  [[ -f "$dir/bun.lockb" ]] && return 0
  [[ -f "$dir/pnpm-lock.yaml" ]] && return 0
  [[ -f "$dir/package-lock.json" ]] && return 0
  [[ -f "$dir/npm-shrinkwrap.json" ]] && return 0
  [[ -f "$dir/yarn.lock" ]] && return 0
  [[ -f "$dir/deno.lock" ]] && return 0
  [[ -f "$dir/package.json" ]] && grep -Eq '"packageManager"[[:space:]]*:' "$dir/package.json" && return 0
  return 1
}

regex_escape() {
  sed 's/[][(){}.^$*+?|\\]/\\&/g' <<<"$1"
}

build_exclude_pattern() {
  local item escaped pattern=""
  for item in "${SYNC_EXCLUDE[@]}"; do
    escaped="$(regex_escape "$item")"
    pattern="${pattern}|(${escaped})"
  done
  printf "(^|/)(%s)(/|$)" "${pattern:1}"
}

spin() {
  local pid=$1 msg=$2 frame=0
  if [[ -t 1 ]]; then
    printf "\033[?25l"
    while kill -0 "$pid" 2>/dev/null; do
      printf "\r\033[K  ${CYAN}${SPINNER[$frame]}${NC} %b" "$msg"
      frame=$(( (frame + 1) % ${#SPINNER[@]} ))
      sleep 0.08
    done
    wait "$pid" 2>/dev/null
    local rc=$?
    printf "\r\033[K"
    printf "\033[?25h"
    return $rc
  else
    wait "$pid" 2>/dev/null
    return $?
  fi
}

require_command git

# Resolve the primary repo root regardless of which worktree cwd is in.
# Uses --git-common-dir which always points at the primary .git, then walks
# up one level to the repo root.
resolve_primary_repo() {
  local git_common
  git_common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
  dirname "$git_common"
}

# Look up the on-disk path of a worktree by its branch name.
# Prints nothing (and returns 0) if no match — callers must check for empty.
lookup_worktree_path() {
  local target_branch="$1"
  git worktree list --porcelain | awk -v b="refs/heads/$target_branch" '
    /^worktree / { path = substr($0, 10) }
    /^branch /   { if ($2 == b) { print path; exit } }
  '
}

# List all branches currently checked out in worktrees, one per line.
# Detached worktrees are printed as "(detached HEAD)".
list_worktree_branches() {
  git worktree list --porcelain | awk '
    /^branch / { sub(/^refs\/heads\//, "", $2); print $2; next }
    /^detached/ { print "(detached HEAD)" }
  '
}

show_help() {
  printf "${BOLD}Usage:${NC} wt <command> [args]\n"
  echo ""
  printf "${BOLD}Commands:${NC}\n"
  echo "  wt [new|create] <branch> [base] [flags]"
  echo "                       Create worktree from base branch (default: main)"
  echo "                       Extra flags are passed to git worktree add"
  echo "  wt rm|remove <branch> [flags]"
  echo "                       Remove worktree (keeps branch by default)"
  echo "                       -D, --delete-branch  Also delete the branch"
  echo "                       Extra flags (e.g. --force) are passed to git worktree remove"
  echo "  wt ls|list [flags]    List all worktrees"
  echo "                       Extra flags are passed to git worktree list"
  echo ""
  printf "${BOLD}Options:${NC}\n"
  echo "  --verbose            Show detailed rsync output"
  echo "  --no-install         Skip dependency install"
  echo "  -h, --help           Show this help"
}

# Parse --verbose flag
VERBOSE=false
INSTALL=true
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --verbose) VERBOSE=true ;;
    --no-install) INSTALL=false ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# No args or help
if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
  show_help
  exit 0
fi

# ── ls ────────────────────────────────────────────────────────
if [[ "$1" == "ls" || "$1" == "list" ]]; then
  shift
  git worktree list "$@"
  exit 0
fi

# ── rm ────────────────────────────────────────────────────────
if [[ "$1" == "rm" || "$1" == "remove" ]]; then
  branch="${2:-}"
  [[ -z "$branch" ]] && show_help && exit 1
  shift 2
  delete_branch=false
  extra_flags=()
  for arg in "$@"; do
    case "$arg" in
      -D|--delete-branch) delete_branch=true ;;
      *) extra_flags+=("$arg") ;;
    esac
  done

  wt_dir="$(lookup_worktree_path "$branch")"
  if [[ -z "$wt_dir" ]]; then
    err "No worktree found for branch ${BOLD}${branch}${NC}"
    printf "    Existing worktrees:\n" >&2
    list_worktree_branches | sed 's/^/      /' >&2
    exit 1
  fi

  info "Removing worktree ${BOLD}${branch}${NC}"
  err_file="$(make_temp_file wt-rm)"

  if [[ "$delete_branch" == true ]]; then
    (git worktree remove ${extra_flags[@]+"${extra_flags[@]}"} "$wt_dir" 2>"$err_file" \
      && git branch -D "$branch" >/dev/null 2>>"$err_file") &
  else
    git worktree remove ${extra_flags[@]+"${extra_flags[@]}"} "$wt_dir" 2>"$err_file" &
  fi
  if spin $! "Removing worktree"; then
    log "Removed ${DIM}${wt_dir}${NC}"
    [[ "$delete_branch" == true ]] && log "Deleted branch ${BOLD}${branch}${NC}"
  else
    err "Failed to remove worktree"
    [[ -s "$err_file" ]] && sed 's/^/    /' "$err_file" >&2
    exit 1
  fi
  exit 0
fi

# ── create ────────────────────────────────────────────────────
if [[ "$1" == "new" || "$1" == "create" ]]; then
  branch="${2:-}"
  [[ -z "$branch" ]] && show_help && exit 1
  shift 2
  if [[ $# -gt 0 && "$1" != -* ]]; then
    base="$1"
    shift
  else
    base="main"
  fi
  extra_flags=("$@")
else
  branch="$1"
  shift
  if [[ $# -gt 0 && "$1" != -* ]]; then
    base="$1"
    shift
  else
    base="main"
  fi
  extra_flags=("$@")
fi

slug="${branch//\//-}"
repo_root="$(resolve_primary_repo)"
repo_name="$(basename "$repo_root")"
wt_dir="$(cd "${repo_root}/.." && pwd)/${repo_name}-worktrees/${slug}"

echo ""
mkdir -p "$(dirname "$wt_dir")"
err_file="$(make_temp_file wt-new)"
if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
  info "Checking out existing branch ${BOLD}${branch}${NC}"
  git worktree add "$wt_dir" "$branch" ${extra_flags[@]+"${extra_flags[@]}"} 2>"$err_file" >/dev/null &
else
  info "Creating worktree ${BOLD}${branch}${NC} from ${DIM}${base}${NC}"
  git worktree add -b "$branch" "$wt_dir" "$base" ${extra_flags[@]+"${extra_flags[@]}"} 2>"$err_file" >/dev/null &
fi
if spin $! "Creating worktree"; then
  log "Worktree created at ${DIM}${wt_dir}${NC}"
else
  err "Failed to create worktree"
  [[ -s "$err_file" ]] && sed 's/^/    /' "$err_file" >&2
  exit 1
fi

# Sync gitignored files that are also ignored in the worktree
info "Syncing gitignored files"
require_command rsync
exclude_pattern="$(build_exclude_pattern)"

rsync_flags="-a"
[[ "$VERBOSE" == true ]] && rsync_flags="-av"
rsync_err_file="$(make_temp_file wt-rsync)"

# Get ignored files from source, filter out heavy artifacts,
# then keep only files that are also ignored by the worktree's gitignore
sync_files=$(git -C "$repo_root" ls-files --others --ignored --exclude-standard \
  | grep -Ev "$exclude_pattern" \
  | git -C "$wt_dir" check-ignore --stdin 2>/dev/null || true)
file_count=$(printf "%s\n" "$sync_files" | grep -c . || true)

(echo "$sync_files" \
  | rsync $rsync_flags --files-from=- "$repo_root/" "$wt_dir/" >/dev/null 2>"$rsync_err_file" || true) &
spin $! "Syncing ${file_count} files"
log "Synced ${BOLD}${file_count}${NC} files"

# Install dependencies
if [[ "$INSTALL" == false ]]; then
  info "Skipping install (--no-install)"
elif ! command -v ni >/dev/null 2>&1; then
  info "Skipping install (ni not found)"
elif ! has_dependency_config "$wt_dir"; then
  info "Skipping install (no lockfile or packageManager)"
else
  info "Installing dependencies"
  echo ""
  (cd "$wt_dir" && ni) &
  wait $!
  ni_rc=$?
  echo ""
  if [[ $ni_rc -eq 0 ]]; then
    log "Dependencies installed"
  else
    err "Dependency install failed (run manually in worktree)"
  fi
fi

echo ""
log "Worktree ready at ${BOLD}${wt_dir}${NC}"
echo ""
